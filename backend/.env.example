# --- Required ---
# MongoDB Atlas connection string (Database → Connect → Drivers → Python)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority

# Mongo logical database name
DB_NAME=psuman_associates

# Comma-separated allowed origins (your deployed frontend URL — Vercel gives you one)
# IMPORTANT: Do NOT use "*" — cookies with credentials require explicit origins.
# Example: CORS_ORIGINS=https://psa-deploy-liard.vercel.app,https://psumanassociates.com
CORS_ORIGINS=https://your-frontend.vercel.app,https://psumanassociates.com

# Optional — Railway / Render set this automatically. Local dev defaults to 8001.
# PORT=8001

# Email delivery environment: development | staging | production
EMAIL_ENVIRONMENT=development

# Resend API Key — leave blank to use mock mode (no real emails sent)
RESEND_API_KEY=

# Resend verified sender
RESEND_FROM_EMAIL=P Suman & Associates <updates@updates.psumanassociates.com>
RESEND_REPLY_TO=contact@psumanassociates.com

# Resend webhook secret for signature verification
RESEND_WEBHOOK_SECRET=

# Test recipient for development/staging dispatches.
# Can be overridden via admin UI → Communication Center → Test Mode.
# If left empty, test sends will fail until configured via the admin UI.
EMAIL_TEST_RECIPIENT=

# Admin Portal Authentication
# ADMIN_USERNAME: login username for the admin portal
ADMIN_USERNAME=admin

# ADMIN_PASSWORD_HASH: bcrypt hash of the admin password.
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# NEVER use a plain string in production.
ADMIN_PASSWORD_HASH=$2b$12$<your_bcrypt_hash_here>

# ADMIN_SESSION_SECRET: random string used to sign JWT session tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be 32+ chars, random, and kept secret. Changing this invalidates all active sessions.
ADMIN_SESSION_SECRET=<generate_a_random_32_char_secret>

# Application environment
ENVIRONMENT=production

# Public frontend URL (used in unsubscribe links etc)
FRONTEND_URL=https://psumanassociates.com
BACKEND_URL=https://your-railway-backend.railway.app
